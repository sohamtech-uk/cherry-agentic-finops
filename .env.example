# Application
CHERRY_ENVIRONMENT=local
CHERRY_PUBLIC_BASE_URL=http://localhost:8080
CHERRY_PERSISTENCE_BACKEND=memory
CHERRY_GEMINI_MODEL=gemini-3.7-flash
CHERRY_AUTO_RECONCILE_SCORE=90
CHERRY_APPROVAL_AMOUNT_GBP=5000
CHERRY_AMOUNT_TOLERANCE_PERCENT=2
CHERRY_MAX_UPLOAD_MB=50

# Neatlogs agent tracing (project API key; keep populated values out of git)
NEATLOGS_API_KEY=
NEATLOGS_WORKFLOW_NAME=fund-manager-control-review

# Protect real private-markets PDF/XLSX/JSON uploads in production.
# Send the same value as the X-Cherry-Demo-Token request header.
CHERRY_PRIVATE_MARKETS_UPLOAD_TOKEN=

# Google Cloud / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
CHERRY_FIRESTORE_COLLECTION=finance_workflows
CHERRY_FUND_MANAGER_FIRESTORE_COLLECTION=fund_manager_cases
CHERRY_EVIDENCE_BUCKET=
CHERRY_PUBSUB_TOPIC=finance-workflow-events

# Alternative: Gemini Developer API (do not set in a public repository)
GOOGLE_API_KEY=

# Optional read-only Cherry Money finance bridge.
# The connector accepts either https://cherrymoney.co.uk or https://cherrymoney.co.uk/api.
CHERRY_MONEY_API_URL=https://cherrymoney.co.uk
CHERRY_MONEY_API_TOKEN=

# Optional FundOps Agent Studio microservice.
# For private Cloud Run, set URL and AUDIENCE to the service URL; Cherry obtains an IAM ID token.
FUNDOPS_STUDIO_API_URL=
FUNDOPS_STUDIO_AUDIENCE=
# For local/non-GCP environments you can use a static bearer token instead of AUDIENCE.
FUNDOPS_STUDIO_API_TOKEN=
FUNDOPS_STUDIO_TIMEOUT_SECONDS=25
